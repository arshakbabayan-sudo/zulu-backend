APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Browser CORS for `/api/*` (Next.js admin/storefront). Comma-separated origins, e.g.
# https://admin.example.com,https://shop.example.com — use * only for local dev.
CORS_ALLOWED_ORIGINS=*

# Must stay false for Bearer-only separated clients. If ever true, set explicit
# CORS_ALLOWED_ORIGINS (never *) and adopt cookie credentials intentionally.
# CORS_SUPPORTS_CREDENTIALS=false

# Optional. Default merges localhost, APP_URL host, etc. Only domains that use
# Laravel session + Sanctum cookie SPA flows belong here — not required for PAT/Bearer API clients.
# SANCTUM_STATEFUL_DOMAINS=

# Shadow rollout: super-admin entry to Next admin at /admin-next (Blade /admin unchanged).
# ADMIN_NEXT_ENABLED=false
# ADMIN_NEXT_ORIGIN=http://127.0.0.1:3000
# ADMIN_NEXT_HEALTH_PATH=/
# ADMIN_NEXT_HEALTH_TIMEOUT=2

# R2 pilot: restrict Next bridge to allowlisted super-admins (comma-separated). Either list may be empty if the other is used; both empty while pilot mode is on denies everyone (cohort_not_configured).
# ADMIN_NEXT_R2_PILOT_MODE=false
# ADMIN_NEXT_R2_ALLOW_EMAILS=ops@example.com,pilot@example.com
# ADMIN_NEXT_R2_ALLOW_USER_IDS=1,2

# Rollback drill: same log pattern as Next unreachable (next_unreachable) without calling the origin. Remove after verification.
# ADMIN_NEXT_ROLLBACK_DRILL_SIMULATE_UNREACHABLE=false

# Service Connections advanced rollout (Step 3.4)
# SERVICE_CONNECTIONS_ADVANCED_ENABLED=true
# SERVICE_CONNECTIONS_REQUIRE_NOTES_FOR_REJECT=true
# SERVICE_CONNECTIONS_REQUIRE_NOTES_FOR_CANCEL=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@zuluspin.com"
MAIL_FROM_NAME="ZULU SPIN"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment gateway driver (required). Supported: stripe, arca, idram
PAYMENT_DRIVER=stripe

# Required when PAYMENT_DRIVER=stripe
STRIPE_KEY=pk_test_your_key_here
STRIPE_SECRET=sk_test_your_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=usd

# Required when PAYMENT_DRIVER=arca (Armenian banks — Ameriabank / VTB / Ardshinbank)
# Endpoint depends on the bank: e.g. https://services.ameriabank.am/VPOS for Ameriabank.
# Credentials come from the merchant agreement signed with the bank.
ARCA_ENDPOINT=
ARCA_CLIENT_ID=
ARCA_USERNAME=
ARCA_PASSWORD=
ARCA_WEBHOOK_SECRET=
ARCA_RETURN_URL=

# Required when PAYMENT_DRIVER=idram
# IDRAM_RECEIVER is your merchant ID from money.idram.am business cabinet.
# IDRAM_SECRET is the shared secret for webhook checksum verification.
IDRAM_RECEIVER=
IDRAM_SECRET=
IDRAM_RETURN_URL=
IDRAM_PAYMENT_URL=https://money.idram.am/payment.aspx

# ─── Supplier APIs ────────────────────────────────────────────────────
# Per-service-type vendor endpoints for the package booking saga.
# When unset, the saga uses StubComponentReserver (always succeeds
# with a synthetic supplier_ref) so dev + tests keep working.
# When set, the matching reserver makes real HTTP calls to /reserve,
# /confirm, /rollback on the vendor endpoint.

# Flight (Amadeus PNR) — preferred over the generic endpoint when set.
# Sandbox base: https://test.api.amadeus.com / Prod: https://api.amadeus.com
AMADEUS_BASE_URL=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_REQUIRES_TICKET_CALL=false

# Flight (generic vendor — only used when Amadeus is not configured)
SUPPLIER_FLIGHT_ENDPOINT=
SUPPLIER_FLIGHT_API_KEY=
SUPPLIER_FLIGHT_TIMEOUT=15

# Hotel PMS / consolidator
SUPPLIER_HOTEL_ENDPOINT=
SUPPLIER_HOTEL_API_KEY=
SUPPLIER_HOTEL_TIMEOUT=15

# Transfer dispatch (driver fleet API)
SUPPLIER_TRANSFER_ENDPOINT=
SUPPLIER_TRANSFER_API_KEY=
SUPPLIER_TRANSFER_TIMEOUT=15

# Car rental aggregator
SUPPLIER_CAR_ENDPOINT=
SUPPLIER_CAR_API_KEY=
SUPPLIER_CAR_TIMEOUT=15

# Excursion provider
SUPPLIER_EXCURSION_ENDPOINT=
SUPPLIER_EXCURSION_API_KEY=
SUPPLIER_EXCURSION_TIMEOUT=15

# Visa support service
SUPPLIER_VISA_ENDPOINT=
SUPPLIER_VISA_API_KEY=
SUPPLIER_VISA_TIMEOUT=30

# Travel insurance provider
SUPPLIER_INSURANCE_ENDPOINT=
SUPPLIER_INSURANCE_API_KEY=
SUPPLIER_INSURANCE_TIMEOUT=15

# ─── Off-site database backup ─────────────────────────────────────────
# Default DB_BACKUP_DISK=local writes to storage/app/private/backups/db
# on the application server (current behavior). To stream nightly dumps
# to an S3-compatible bucket (Backblaze B2 / Hetzner Object Storage /
# Wasabi / Cloudflare R2), set DB_BACKUP_DISK=backup AND fill in the
# BACKUP_DISK_* vars below.
#
# Provider quickstart:
#   Backblaze B2 free tier (10 GB):
#     BACKUP_DISK_ENDPOINT=https://s3.us-west-002.backblazeb2.com
#     BACKUP_DISK_REGION=us-west-002
#   Hetzner Object Storage (€4.95/mo, 1 TB):
#     BACKUP_DISK_ENDPOINT=https://fsn1.your-objectstorage.com
#     BACKUP_DISK_REGION=fsn1
#   Wasabi (1 TB / $6.99/mo):
#     BACKUP_DISK_ENDPOINT=https://s3.wasabisys.com
#     BACKUP_DISK_REGION=us-east-1
DB_BACKUP_DISK=local
DB_BACKUP_KEEP=14
BACKUP_DISK_KEY=
BACKUP_DISK_SECRET=
BACKUP_DISK_REGION=
BACKUP_DISK_BUCKET=
BACKUP_DISK_ENDPOINT=
BACKUP_DISK_USE_PATH_STYLE=true

# ─── Sentry error tracking (Sprint H1) ─────────────────────────────────
# Provided per environment. Leave blank in dev to disable Sentry reporting
# entirely (the SDK no-ops with no DSN). Production DSN lives only in the
# Hetzner .env, never in git.
SENTRY_LARAVEL_DSN=
# Optional: tag uploads with the release SHA so issues group by deploy.
# Set via CI: SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=
# Trace sampling — start at 0 (errors only). Bump to 0.1 once we have
# baseline volume to keep paid-tier overflow under control.
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# Sentry API auth token (Settings → Auth Tokens in the Sentry UI).
# Used by the scheduled sentry:poll-issues command to read issues
# from all three projects and post Telegram alerts. No-op when unset.
# Org-format tokens (sntrys_...) carry the necessary scopes by default.
SENTRY_API_TOKEN=
# Region host for the Sentry org. ZULU's org sits in the EU region;
# Sentry org tokens authenticate against the region host, not the
# global sentry.io endpoint. Default below covers the prod setup.
SENTRY_API_REGION=de.sentry.io

# ─── Snyk dependency scanning ──────────────────────────────────────────
# Personal API token (snyk.io → Settings → General → API Token).
# Used by snyk:poll-issues to read vulnerability counts and post a
# weekly Telegram digest + count-rise alerts. No-op when unset.
SNYK_API_TOKEN=
# Snyk org slug (URL segment under app.snyk.io/org/<slug>).
SNYK_ORG=arshakbabayan-sudo
